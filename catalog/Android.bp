package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_protobuf {
    name: "libhealth_api",
    crate_name: "health_api",
    protos: [
        ":libhealth_protos",
    ],
    rustlibs: ["libvsidl_v1_stdlib_proto_rs"],
    source_stem: "health_api_source_stable",
    proto_flags: [
        "-I external/protobuf/src",
    ],
    exported_include_dirs: ["."],
    product_available: true,
    vendor_available: true,
    host_supported: true,
    min_sdk_version: "35",
}

filegroup {
    name: "libhealth_protos",
    srcs: [
        "*.proto",
    ],
}

filegroup {
    name: "health_v1_catalog_files",
    srcs: [
        ":libhealth_protos",
        "*.vsidl",
        "Android.bp",
    ],
}

filegroup {
    name: "libhealth_vsidl",
    srcs: [
        "*.proto",
        "health_monitor.vsidl",
    ],
}

filegroup {
    name: "libhealth_vsidl_with_bp_file",
    srcs: [
        ":libhealth_vsidl",
        "Android.bp",
    ],
}
