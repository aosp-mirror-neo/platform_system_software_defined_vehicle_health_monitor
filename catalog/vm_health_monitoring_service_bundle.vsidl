# proto-file: //system/software_defined_vehicle/core_services/vsidl/protos/sdv/vsidl/v1/syntax.proto
# proto-message: VsidlEntry

package: "com.sdv.sample_oem.health.monitoring"

# Defining a new SDV health monitor, which
# subscribes to multiple topics for reading the heartbeats of critical SDV services bundles
# and provides RPC interfaces for (de)registering from health monitoring
# and retrieving the list of unhealthy service bundles on the VM.

# Only used in integration test - `sdv_health_monitor_integration_tests`
service_bundle {

  name: "VmHMBundle"
  # For reading details about failing and unhealthy services.
  client {
    service: "com.sdv.google.health.HealthMonitorService"
  }
  # For retrieving the health of a VM.
  subscriber {
    message: "com.sdv.google.health.VmHealth"
  }
}
