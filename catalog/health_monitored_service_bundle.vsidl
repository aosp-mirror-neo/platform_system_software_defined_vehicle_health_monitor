# proto-file: //system/software_defined_vehicle/vsidl/language/src/protos/sdv/vsidl/v1/syntax.proto
# proto-message: VsidlEntry

package: "com.android.sdv.sample.oem.health.monitored"

# Defining a service bundle sample which
# - Registers at the local health monitor for service heartbeat monitoring
# - Publishes service heartbeats locally.
service_bundle {

  name: "SampleHMBundle"

  # Service bundle should register at HM for service heartbeat monitoring.
  client {
    service: "com.android.sdv.health.HealthMonitorRegistrationService"
    channel: "health-monitor-registration-service"
  }

  # This bundle publishes heartbeats
  publisher {
    message: "com.android.sdv.health.ServiceHeartbeat"
    topic: "sample-bundle-heartbeats"
    capacity: 2
  }
}

service_bundle {

  name: "SecondSampleHMBundle"

  # Service bundle should register at HM for service heartbeat monitoring.
  client {
    service: "com.android.sdv.health.HealthMonitorRegistrationService"
    channel: "health-monitor-registration-service"
  }

  # This bundle publishes heartbeats
  publisher {
    message: "com.android.sdv.health.ServiceHeartbeat"
    topic: "second-sample-bundle-heartbeats"
    capacity: 2
  }
}