# proto-file: //system/software_defined_vehicle/core_services/vsidl/protos/sdv/vsidl/v1/syntax.proto
# proto-message: VsidlEntry

package: "com.sdv.google.health"

# Defining a VM Health Monitor Agent, which
# subscribes to multiple topics for reading the service heartbeats of critical SDV services bundles
# and provides RPC interfaces for (de)registering from health monitoring
# and retrieving details about unhealthy or crashed service bundles on the VM.
service_bundle {

  name: "HealthMonitorServiceBundle"

  server {
    service: "HealthMonitorRegistrationService"
  }
  server {
    service: "HealthMonitorService"
  }

  publisher { message: "VmHealth" }

  subscriber{ message: "ServiceHeartbeat"}
}

# Define a publisher for ServiceHeartbeat for runtime config generation (`generate_hm_stable_topic_mappings`)
# to succeed - Will be addressed by b/380246543
service_bundle {
  name: "FakeBundle"
  publisher { message: "ServiceHeartbeat"}
}
