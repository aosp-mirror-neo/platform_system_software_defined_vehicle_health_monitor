# proto-file: //system/software_defined_vehicle/middleware/service_authz/proto/sdv/authz/policy/acl_policy.proto
# proto-message: AclPolicy

# ACL policies for HealthMonitor Unit Types.

acls {
    name: "Internal"
    include: "com.sdv.google.health.HealthMonitorServiceBundle"
}

acls {
    name: "MonitoringClients"
    include: "com.sdv.someip.SomeIpBroker"
    include: "com.sdv.sample_oem.health.monitoring.VmHMBundle"
}

acls {
    name: "MonitoredClients"
    include: "com.sdv.sample_oem.*"
    include: "com.andorid.sdv.performance.*"
}

unit_types {
    name: "VmHealth"
    acl_names: "Internal"
}

unit_types {
    name: "HealthMonitorRegistrationService"
    acl_names: "Internal"
}

unit_types {
    name: "HealthMonitorService"
    acl_names: "Internal"
}

unit_types {
    name: "ServiceHeartbeat"
    acl_names: "MonitoredClients"
}

service_units {
    name: "com-sdv-google-health-vm-health-unique"
    acl_names: "MonitoringClients"
}

service_units {
    name: "com-sdv-google-health-health-monitor-service"
    acl_names: "MonitoringClients"
}

service_units {
    name: "com-sdv-google-health-health-monitor-registration-service"
    acl_names: "MonitoredClients"
}
