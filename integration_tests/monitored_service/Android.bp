rust_binary {
    name: "sdv_integration_test_health_monitored_service",
    srcs: [
        "src/main.rs",
    ],
    prefer_rlib: true,
    rustlibs: [
        "google.sdv.service_bundles_registry-V3-rust",
        "libanyhow",
        "libcom_android_sdv_health_health_monitor_registration_service_rpc_rs",
        "libfutures",
        "libhealth_api",
        "liblog_rust",
        "libprotobuf",
        "libsdv_comms_rs",
        "libsdv_lifecycle_client_rust",
        "libsdv_mw_rs_com_android_sdv_sample_oem_health_monitored_sample_hm_bundle",
        "libsdv_mw_rs_com_android_sdv_sample_oem_health_monitored_second_sample_hm_bundle",
        "libsdv_mw_rs_comms",
        "libsdv_mw_rs_sdv_comms",
        "libsdv_status_rs",
        "libtokio_util",
        "libtokio",
        "libclap",
        "libserde",
        "libserde_json",
    ],
    ld_flags: ["-Wl,--no-as-needed"],
    product_specific: true,
}
