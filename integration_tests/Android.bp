rust_test {
    name: "sdv_core_core_services_integration_single_vm_hm_test",
    srcs: [
        "src/main.rs",
    ],
    defaults: ["health_monitor_stable@rust_defaults"],
    rustlibs: [
        "libbinder_rs",
        "libclap",
        "libtokio",
        "liblog_rust",
        "librustutils",
        "libtokio_util",
        "liblazy_static",
        "libsdv_mw_rs_com_sdv_sample_oem_health_monitoring_vm_hm_bundle",
        "libcom_sdv_google_health_health_monitor_service_rpc_rs",
    ],
    ld_flags: ["-Wl,--no-as-needed"],
    require_root: true,
    test_options: {
        unit_test: false,
    },
    test_suites: [
        "general-tests",
        "automotive-sdv-tests",
    ],
    auto_gen_config: true,
}
