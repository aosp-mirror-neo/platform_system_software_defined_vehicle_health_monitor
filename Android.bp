package {
    default_team: "trendy_team_automotive",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_binary {
    name: "sdv_health_monitor",
    srcs: [
        "src/main.rs",
    ],
    prefer_rlib: true,
    rustlibs: [
        "libanyhow",
        "libsdv_dump",
        "libhealth_api",
        "liblog_rust",
        "librustutils",
        "libsdv_comms_ctx_impl",
        "libsdv_comms_rs",
        "libsdv_health_monitor",
        "libsdv_log_rust",
        "libsdv_mw_rs_com_sdv_google_health_health_monitor_service_bundle",
        "libsdv_mw_rs_sdv_comms",
        "libtokio",
        "libbinder_rs",
    ],
    defaults: [
        "sdv_tracing@rust_defaults",
    ],
    proc_macros: [
        "libasync_trait",
    ],
    ld_flags: ["-Wl,--no-as-needed"],
    system_ext_specific: true,
}

rust_library {
    name: "libsdv_health_monitor",
    srcs: [
        "src/health_monitor.rs",
    ],
    defaults: ["health_monitor_stable@rust_defaults"],
    prefer_rlib: true,
}

rust_defaults {
    name: "health_monitor_stable@rust_defaults",
    defaults: [
        "sdv@rust_defaults",
        "sdv_tracing@rust_defaults",
    ],
    crate_name: "sdv_health_monitor",
    rustlibs: [
        "libanyhow",
        "libbinder_rs",
        "libbinder_ndk",
        "liblog_rust",
        // HM uses ServiceFqin to communicate with Orch SB Recovery binder interface:
        "google.sdv.identity-V2-rust",
        "google.sdv.orchestration-rust",
        "google.sdv.vpm-V1-rust",
        "libpersistent_binder",
        "libprotobuf",
        "libsdv_log_rust",
        "libsdv_dump",
        "libmockall",
        "libfutures",
        "libtokio",
        "libhealth_api",
        "libgoogletest_rust",
        "librustutils",
        "libsdv_status_rs",
        "libsdv_comms_rs",
        "libsdv_mw_rs_comms",
        "libsdv_mw_rs_sdv_comms",
        "libsdv_mw_rs_com_sdv_google_health_health_monitor_service_bundle",
        "libcom_sdv_google_health_health_monitor_service_rpc_rs",
        "libcom_sdv_google_health_health_monitor_registration_service_rpc_rs",
    ],
    proc_macros: [
        "libasync_trait",
    ],
}

rust_test {
    name: "sdv_core_core_services_unit_health_monitor_test",
    srcs: [
        "src/health_monitor.rs",
    ],
    defaults: ["health_monitor_stable@rust_defaults"],
    test_options: {
        unit_test: true,
    },
    test_suites: [
        "general-tests",
        "automotive-sdv-tests",
    ],
    auto_gen_config: true,
    rustlibs: [
        "libtokio_stream",
    ],
    data: [
        "src/test_configs/*",
    ],
    ld_flags: ["-Wl,--no-as-needed"],
    require_root: true,
    test_config_template: ":sdv_authz_enforcement_flag_enabled_config_template",
}

prebuilt_etc {
    name: "hm_config_with_someip.textproto",
    sub_dir: "health_monitor",
    src: "src/prod_configs/hm_config_with_someip.textproto",
}

prebuilt_etc {
    name: "hm_config_without_someip.textproto",
    sub_dir: "health_monitor",
    src: "src/prod_configs/hm_config_without_someip.textproto",
}
